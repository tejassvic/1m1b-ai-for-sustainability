# Verdant — shared editor settings
# Keeps indentation and line endings identical whatever anyone opens the repo in.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{jsx,js,json,css,html}]
indent_size = 2

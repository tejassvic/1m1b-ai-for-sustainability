# Verdant frontend configuration
#
# Copy to `.env.local` only if you need to override the defaults.

# Base URL of the Verdant API.
#
# Leave this UNSET in development: the Vite dev server proxies /api to
# http://127.0.0.1:8000, so the browser only ever talks to one origin.
#
# Set it for a deployed build, pointing at wherever the FastAPI service runs:
# VITE_API_BASE_URL=https://api.verdant.earth/api/v1
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api.
# VERDANT_API_URL=http://127.0.0.1:8000

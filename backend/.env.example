# ---------------------------------------------------------------------------
# Verdant backend configuration
#
# Copy this file to `.env` and fill in what you have. Everything has a safe
# default: with no credentials at all the platform still runs end to end using
# the grounded fallback responder (see LLM_PROVIDER below).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
VERDANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Language model ---------------------------------------------------------
# auto     -> IBM Granite on watsonx.ai when credentials are present,
#             otherwise Ollama when OLLAMA_ENABLED=true,
#             otherwise the grounded fallback responder.
# watsonx  -> force IBM Granite via watsonx.ai
# ollama   -> force a locally running Granite model via Ollama
# grounded -> force the deterministic, retrieval-grounded responder (offline)
LLM_PROVIDER=auto

# --- IBM watsonx.ai (IBM Granite) -------------------------------------------
# Create a project key at https://cloud.ibm.com and copy the project id from
# the watsonx.ai project's "Manage" tab.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Ollama (optional local Granite) ----------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.2:latest

# --- Generation -------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.05
